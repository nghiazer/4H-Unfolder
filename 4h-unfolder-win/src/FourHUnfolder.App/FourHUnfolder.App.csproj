<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <OutputType>WinExe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- HelixToolkit.WPF 2.25.0 targets .NETFramework but works via compat mode on net8.0-windows -->
    <NoWarn>NU1701</NoWarn>
    <RootNamespace>FourHUnfolder.App</RootNamespace>
    <AssemblyName>4H-Unfolder</AssemblyName>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>

    <!-- Version — bump suffix letter for patch releases within a minor version -->
    <Version>1.1.0.0</Version>
    <AssemblyVersion>1.1.0.0</AssemblyVersion>
    <FileVersion>1.1.0.0</FileVersion>
    <InformationalVersion>1.1.0.A — Full-codebase cross-review: fixed group/undo bugs (RerunUnfold wiping UserGroupId, group-drag not moving siblings, missing Auto-Arrange undo snapshot), a MainViewModel lifetime leak on exit, a Release-build silent settings-save failure, untrusted-input hardening in the PDO loader and .4hu bundle loader, a PDF export crash on malformed colors, and a stale title-bar version string; captured real Quick-Start screenshots</InformationalVersion>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\FourHUnfolder.Application\FourHUnfolder.Application.csproj" />
    <ProjectReference Include="..\FourHUnfolder.Infrastructure\FourHUnfolder.Infrastructure.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="HelixToolkit.WPF"                        Version="2.25.0" />
    <PackageReference Include="CommunityToolkit.Mvvm"                   Version="8.3.2"  />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1"  />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Assets\app.ico"/>
    <Resource Include="Assets\logo.png"/>
  </ItemGroup>
</Project>
